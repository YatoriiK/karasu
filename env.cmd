@echo off
set "KARASU_ROOT=%~dp0"
set "KARASU_ROOT=%KARASU_ROOT:~0,-1%"
set "PIP_CACHE_DIR=%KARASU_ROOT%\cache\pip"
set "TEMP=%KARASU_ROOT%\cache\tmp"
set "TMP=%KARASU_ROOT%\cache\tmp"
set "HF_HOME=%KARASU_ROOT%\cache\hf"
set "TORCH_HOME=%KARASU_ROOT%\cache\torch"
set "npm_config_cache=%KARASU_ROOT%\cache\npm"
set "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1"
set "CARGO_TARGET_DIR=%KARASU_ROOT%\cache\cargo-target"
set "PYTHONUTF8=1"
set "PYTHONIOENCODING=utf-8"
set "HF_HUB_DISABLE_SYMLINKS_WARNING=1"
set "KARASU_PY=%KARASU_ROOT%\.venv\Scripts\python.exe"
if not exist "%TEMP%" mkdir "%TEMP%"
