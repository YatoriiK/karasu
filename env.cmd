@echo off
set "CD_ROOT=%~dp0"
set "CD_ROOT=%CD_ROOT:~0,-1%"
set "PIP_CACHE_DIR=%CD_ROOT%\cache\pip"
set "TEMP=%CD_ROOT%\cache\tmp"
set "TMP=%CD_ROOT%\cache\tmp"
set "HF_HOME=%CD_ROOT%\cache\hf"
set "TORCH_HOME=%CD_ROOT%\cache\torch"
set "npm_config_cache=%CD_ROOT%\cache\npm"
set "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1"
set "CARGO_TARGET_DIR=%CD_ROOT%\cache\cargo-target"
set "PYTHONUTF8=1"
set "PYTHONIOENCODING=utf-8"
set "HF_HUB_DISABLE_SYMLINKS_WARNING=1"
set "CD_PY=%CD_ROOT%\.venv\Scripts\python.exe"
if not exist "%TEMP%" mkdir "%TEMP%"
