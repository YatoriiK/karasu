{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karasu",
  "version": "0.5.11",
  "identifier": "app.karasu.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8765 ws://127.0.0.1:8765",
        "img-src": "'self' data: blob: http://127.0.0.1:8765",
        "media-src": "'self' blob: http://127.0.0.1:8765",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Karasu music discovery",
    "resources": {
      "engine/": "engine/"
    },
    "licenseFile": "../../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "startMenuFolder": "Karasu"
      }
    },
    "publisher": "Karasu",
    "copyright": "Copyright © 2026 the Karasu contributors. Licensed under the GNU GPL v3 or later.",
    "category": "Music",
    "longDescription": "Finds music you haven't heard yet: new niche artists and older records almost nobody found. Runs on your PC."
  }
}